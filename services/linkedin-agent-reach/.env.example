# --- Sidecar host configuration (this service) ---
# Bearer token the app must present. Generate with: openssl rand -hex 32
LINKEDIN_SERVICE_TOKEN=
# Port/interface for the HTTP listener (put a TLS terminator in front).
PORT=8787
HOST=0.0.0.0
# How the MCP LinkedIn server is launched.
MCP_COMMAND=mcp-server-linkedin
MCP_ARGS=
MCP_CWD=
MCP_REQUEST_TIMEOUT_MS=60000
# Requests per minute per client IP.
RATE_LIMIT=30

# --- Values to set on the Lovable app side (NOT here) ---
# LINKEDIN_SERVICE_URL   = https://your-sidecar-host           (no trailing slash)
# LINKEDIN_SERVICE_TOKEN = the same token as above
# LINKEDIN_SERVICE_TIMEOUT_MS = 45000 (optional)
